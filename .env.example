# -------------------------------------------------------------
# StockPilot AI — Environment Configuration Example
# -------------------------------------------------------------

# MySQL Database Settings
MYSQL_ROOT_PASSWORD=change-me-in-production-root-password
MYSQL_DATABASE=stockpilot
MYSQL_USER=stockuser
MYSQL_PASSWORD=change-me-in-production-user-password
MYSQL_PORT=3306

# Direct JDBC URL (for running backend locally against MySQL outside Docker)
DB_URL=jdbc:mysql://localhost:3306/stockpilot?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=stockuser
DB_PASSWORD=change-me-in-production-user-password

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Security (HMAC-SHA256 256-bit Hex string)
# Generate a new random secret in production: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_YOUR_GENERATED_SECRET

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# SQL Logging (Keep false in production to prevent performance degradation and sensitive data logging)
SHOW_SQL=false

# Generative AI Provider (Optional: System operates deterministically if disabled or unset)
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
